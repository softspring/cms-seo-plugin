{% trans_default_domain 'sfs_cms_seo' %}

{% extends '@SfsCms/admin_layout.html.twig' %}

{% block title %}{{ 'dashboard.meta.title'|trans }}{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'dashboard.breadcrumb'|trans }}</li>
{% endblock breadcrums_content %}

{% block content %}
    <div class="container-fluid py-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 mb-1">{{ 'dashboard.title'|trans }}</h1>
                <p class="text-body-secondary mb-0">{{ 'dashboard.description'|trans }}</p>
            </div>
            <form method="post" action="{{ url('sfs_cms_admin_seo_contents_analyze') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('sfs_cms_seo_analyze_contents') }}">
                <button type="submit" class="btn btn-sm btn-primary">{{ 'dashboard.actions.refresh_contents'|trans }}</button>
            </form>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-2">
                <div class="card h-100"><div class="card-body"><div class="text-body-secondary small">{{ 'dashboard.stats.average_score'|trans }}</div><div class="h3 mb-0">{{ stats.averageScore }}/100</div></div></div>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <div class="card h-100"><div class="card-body"><div class="text-body-secondary small">{{ 'dashboard.stats.analyzed'|trans }}</div><div class="h3 mb-0">{{ stats.analyzed }}/{{ stats.published }}</div></div></div>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <div class="card h-100"><div class="card-body"><div class="text-body-secondary small">{{ 'dashboard.stats.pending'|trans }}</div><div class="h3 mb-0">{{ stats.pending }}</div></div></div>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <div class="card h-100"><div class="card-body"><div class="text-body-secondary small">{{ 'dashboard.stats.urls'|trans }}</div><div class="h3 mb-0">{{ stats.urls }}</div></div></div>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <div class="card h-100"><div class="card-body"><div class="text-body-secondary small">{{ 'summary.errors'|trans }}</div><div class="h3 mb-0 text-danger">{{ stats.errors }}</div></div></div>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <div class="card h-100"><div class="card-body"><div class="text-body-secondary small">{{ 'summary.warnings'|trans }}</div><div class="h3 mb-0 text-warning">{{ stats.warnings }}</div></div></div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="h5 mb-0">{{ 'dashboard.sites.title'|trans }}</h2>
                    <div class="small text-body-secondary">{{ 'dashboard.sites.description'|trans }}</div>
                </div>
                <form method="post" action="{{ url('sfs_cms_admin_seo_sites_analyze') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('sfs_cms_seo_analyze_sites') }}">
                    <button type="submit" class="btn btn-sm btn-outline-primary">{{ 'dashboard.actions.refresh_sites'|trans }}</button>
                </form>
            </div>
            <div class="card-body border-bottom">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="text-body-secondary small">{{ 'dashboard.sites.stats.average_score'|trans }}</div>
                        <div class="h4 mb-0">{{ site_stats.averageScore }}/100</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-body-secondary small">{{ 'dashboard.sites.stats.analyzed'|trans }}</div>
                        <div class="h4 mb-0">{{ site_stats.analyzed }}/{{ site_stats.sites }}</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-body-secondary small">{{ 'summary.errors'|trans }}</div>
                        <div class="h4 mb-0 text-danger">{{ site_stats.errors }}</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-body-secondary small">{{ 'summary.warnings'|trans }}</div>
                        <div class="h4 mb-0 text-warning">{{ site_stats.warnings }}</div>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'table.site'|trans }}</th>
                            <th>{{ 'dashboard.sites.table.host'|trans }}</th>
                            <th class="text-end">{{ 'summary.score'|trans }}</th>
                            <th class="text-end">{{ 'summary.errors'|trans }}</th>
                            <th class="text-end">{{ 'summary.warnings'|trans }}</th>
                            <th>{{ 'table.status'|trans }}</th>
                            <th>{{ 'dashboard.sites.table.checked_at'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in site_rows %}
                            {% set analysis = row.analysis %}
                            {% set site_seo_url = url('sfs_cms_admin_sites_seo', {'site': row.site.id}) %}
                            <tr>
                                <td class="fw-semibold"><a href="{{ site_seo_url }}">{{ row.site.id }}</a></td>
                                <td>{{ row.site.host ?: '-' }}</td>
                                <td class="text-end fw-semibold">{{ analysis.score }}/100</td>
                                <td class="text-end"><a href="{{ site_seo_url }}" class="text-danger text-decoration-none fw-semibold">{{ row.errors }}</a></td>
                                <td class="text-end"><a href="{{ site_seo_url }}" class="text-warning text-decoration-none fw-semibold">{{ row.warnings }}</a></td>
                                <td><span class="badge text-bg-{{ analysis.severity == 'error' ? 'danger' : (analysis.severity == 'warning' ? 'warning' : (analysis.severity == 'info' ? 'info' : 'success')) }}">{{ ('severity.'~analysis.severity)|trans }}</span></td>
                                <td>{{ row.analyzedAt ?: '-' }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="text-body-secondary">{{ 'dashboard.empty'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-6">
                <div class="card h-100">
                    <div class="card-header bg-transparent">
                        <h2 class="h5 mb-0">{{ 'dashboard.worst_contents.title'|trans }}</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>{{ 'dashboard.table.content'|trans }}</th>
                                    <th>{{ 'dashboard.table.type'|trans }}</th>
                                    <th class="text-end">{{ 'summary.score'|trans }}</th>
                                    <th class="text-end">{{ 'summary.issues'|trans }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in worst_contents %}
                                    <tr>
                                        <td>
                                            <a href="{{ url(row.seoRoute ?: row.detailsRoute, {'content': row.content.id}) }}">{{ row.content.name }}</a>
                                            {% if row.version %}<div class="small text-body-secondary">v{{ row.version.versionNumber }}</div>{% endif %}
                                        </td>
                                        <td>{{ ('dashboard.content_types.'~row.type)|trans }}</td>
                                        <td class="text-end fw-semibold">{{ row.score }}/100</td>
                                        <td class="text-end"><span class="text-danger">{{ row.errors }}</span> / <span class="text-warning">{{ row.warnings }}</span></td>
                                        <td class="text-end">
                                            {% if row.seoRoute %}<a class="btn btn-sm btn-outline-secondary" href="{{ url(row.seoRoute, {'content': row.content.id}) }}">{{ 'dashboard.actions.seo'|trans }}</a>{% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="5" class="text-body-secondary">{{ 'dashboard.empty'|trans }}</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="card h-100">
                    <div class="card-header bg-transparent">
                        <h2 class="h5 mb-0">{{ 'dashboard.worst_urls.title'|trans }}</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>{{ 'table.url'|trans }}</th>
                                    <th>{{ 'dashboard.table.content'|trans }}</th>
                                    <th class="text-end">{{ 'summary.score'|trans }}</th>
                                    <th>{{ 'table.status'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in worst_urls %}
                                    <tr>
                                        <td>
                                            <a href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.path ?: row.url }}</a>
                                            <div class="small text-body-secondary">{{ row.site }} · {{ row.locale }}</div>
                                        </td>
                                        <td><a href="{{ url(row.seoRoute ?: row.detailsRoute, {'content': row.content.id}) }}">{{ row.content.name }}</a></td>
                                        <td class="text-end fw-semibold">{{ row.score }}/100</td>
                                        <td><span class="badge text-bg-{{ row.severity == 'error' ? 'danger' : (row.severity == 'warning' ? 'warning' : (row.severity == 'info' ? 'info' : 'success')) }}">{{ ('severity.'~row.severity)|trans }}</span></td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="4" class="text-body-secondary">{{ 'dashboard.empty'|trans }}</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock content %}
